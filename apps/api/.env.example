# Server configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/reportbd?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@cluster0.mongodb.net/reportbd?retryWrites=true&w=majority
MONGODB_DB_NAME=reportbd

# Firebase Admin SDK (From Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Reverse Proxy (Set true if behind Cloudflare, Nginx, or AWS ALB)
TRUST_PROXY=false
