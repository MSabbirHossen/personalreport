{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*\\.(?:ico|png|svg|jpg|jpeg|gif|webp|json|css|js|woff|woff2|ttf|eot))",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ]
}

